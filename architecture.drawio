  <diagram name="crewly-auditor-bypass" id="auditor-bypass-page">
    <mxGraphModel dx="1204" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="ab-0" />
