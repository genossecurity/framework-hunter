        <mxCell id="ab-title" parent="ab-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="crewly — where the Auditor&#39;s create_github_issue sink sits (GHSA-v7q6-5mpg-q47w)" vertex="1">
          <mxGeometry height="36" width="1080" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ab-sub" parent="ab-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#FFFFFF;" value="All agents run under the same runner. The security model guards the loud door (worker bash_exec); the quiet door (Auditor issue-filing) reaches the same OS and is waved through both gates." vertex="1">
          <mxGeometry height="30" width="1080" x="40" y="54" as="geometry" />
        </mxCell>
        <mxCell id="ab-runner" parent="ab-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=top;spacingTop=8;fontColor=#000000;" value="&lt;b&gt;agent-runner.service.ts&lt;/b&gt;&#xa;runs ALL agents · checkApproval() (line 2221)&#xa;&#xa;gate 1: readOnlyMode blocks WRITE_TOOLS (types.ts:379)&#xa;gate 2: requireApproval blocks by sensitivity" vertex="1">
          <mxGeometry height="110" width="520" x="330" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ab-orch" parent="ab-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=8;fontColor=#000000;" value="&lt;b&gt;ORCHESTRATOR agent&lt;/b&gt;&#xa;(peer — delegates work)&#xa;&#xa;delegate_task&#xa;start_agent / stop_agent&#xa;send_message" vertex="1">
          <mxGeometry height="150" width="250" x="60" y="300" as="geometry" />
        </mxCell>
        <mxCell id="ab-worker" parent="ab-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=8;fontColor=#000000;" value="&lt;b&gt;WORKER agents&lt;/b&gt;&#xa;(developer, coder-1 …)&#xa;tools from tool-registry.ts&#xa;&#xa;• bash_exec — DESTRUCTIVE&#xa;&amp;nbsp;&amp;nbsp;approval-gated ✔&#xa;&amp;nbsp;&amp;nbsp;validateBashCommand denylist ✔&#xa;&amp;nbsp;&amp;nbsp;(rm / curl / wget blocked)" vertex="1">
          <mxGeometry height="170" width="300" x="400" y="300" as="geometry" />
        </mxCell>
        <mxCell id="ab-auditor" parent="ab-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=8;fontColor=#000000;" value="&lt;b&gt;AUDITOR agent&lt;/b&gt;&#xa;contract: &quot;read-only, no state change&quot;&#xa;tools from auditor-tools.ts (NO bash_exec)&#xa;&#xa;• read logs / get_status&#xa;• write_audit_report&#xa;• create_github_issue  ⬇" vertex="1">
          <mxGeometry height="150" width="300" x="800" y="300" as="geometry" />
        </mxCell>
        <mxCell id="ab-sink" parent="ab-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;verticalAlign=top;spacingTop=8;fontColor=#000000;" value="&lt;b&gt;★ create_github_issue sink&lt;/b&gt; (CWE-78)&#xa;execSync(`gh issue create --title &quot;${title}&quot;`)&#xa;only &quot; is escaped → $(cmd) executes&#xa;&#xa;absent from WRITE_TOOLS → gate 1 misses&#xa;absent from TOOL_SENSITIVITY → defaults &#39;safe&#39; → gate 2 misses" vertex="1">
          <mxGeometry height="130" width="360" x="770" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ab-inject" parent="ab-1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;verticalAlign=top;spacingTop=6;fontColor=#000000;" value="&lt;b&gt;Injection source&lt;/b&gt;&#xa;attacker gets $(…) into logs / commit&#xa;msg / task note the Auditor audits&#xa;(indirect prompt injection)" vertex="1">
